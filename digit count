
import java.util.*;
class digit {
    public static void main(String[] args) {
        Scanner scan=new Scanner(System.in);//1234=1+2+3+4=10,1+0=1
        int n=scan.nextInt();//
        while(n>=10){
           int sum=0;
           while(n>0){
               int rev=n%10;
               sum=sum+rev;
               n=n/10;
             
           }n=sum;
        }System.out.println("digit"+n);
    }
}
